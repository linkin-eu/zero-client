#!/usr/bin/env bash
# NetworkManager dispatcher: when NetworkManager detects a portal it wakes dot1x-enroll, which alone opens the portal
# browser (only once 802.1X runs, so the right login page shows); once the network is fully open it closes the window
# and runs the Ansible units that failed while the device was still behind the portal.

DESKTOP_USER=zero
source /usr/local/lib/dot1x-enroll/portal.sh

case "$2" in
  up|dhcp4-change)
    # The switch moves the port to the working VLAN without a link change, so NetworkManager would keep reporting
    # the portal until its next periodic check; checking now closes the portal window as soon as the address changes
    nmcli networking connectivity check >/dev/null 2>&1
    ;;
  connectivity-change)
    case "$CONNECTIVITY_STATE" in
      PORTAL)
        # Only the monitor gets the signal, never a dot1x-enroll run in progress
        systemctl kill --kill-whom=main --signal=USR1 dot1x-enroll.service 2>/dev/null
        ;;
      FULL)
        close_portal_browser
        # These only run on the working network, so at boot behind the portal they fail once and are started here
        for ansible_unit in ansible-first-boot.service ansible-boot.service; do
          if systemctl is-enabled --quiet "$ansible_unit" && systemctl is-failed --quiet "$ansible_unit"; then
            systemctl start --no-block "$ansible_unit"
          fi
        done
        ;;
    esac
    ;;
esac
exit 0
