[Unit]
Description=Ansible Update at Boot
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment="ANSIBLE_LOG_PATH=/home/zero/.config/linkin/ansible-boot.log"
# The branch the playbook is pulled from, set when the image is built
EnvironmentFile=/etc/default/zero-client
# Only on the working network: a captive portal answers the connectivity check with something other than 204
ExecStartPre=/usr/local/bin/working-network-check.sh
ExecStartPre=/usr/bin/wget -q https://raw.githubusercontent.com/techno-link/zero-client/refs/heads/${PLAYBOOK_BRANCH}/ansible/zero.yml -O /root/zero.yml
ExecStart=/usr/bin/ansible-playbook /root/zero.yml -v

[Install]
WantedBy=multi-user.target
